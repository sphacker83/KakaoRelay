<UserControl x:Class="KakaoRelay.App.SummaryForwardPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel>
   <Button Content="새 규칙" DockPanel.Dock="Right" Click="New_Click" Padding="8,5" Margin="6,0,0,0" IsEnabled="{Binding CanEdit}"/>
   <Button Content="삭제" DockPanel.Dock="Right" Click="Delete_Click" Padding="8,5" Margin="6,0,0,0" IsEnabled="{Binding CanEdit}"/>
   <ComboBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" DisplayMemberPath="Label" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="정리 전달 규칙"/>
  </DockPanel>
  <DockPanel Grid.Row="1" Margin="0,8,0,5">
   <Button Content="방 새로고침" DockPanel.Dock="Right" Click="Refresh_Click" Padding="8,5" IsEnabled="{Binding CanEdit}"/>
   <TextBlock Text="감시할 방 · 자동답장과 별도" VerticalAlignment="Center" FontSize="12"/>
  </DockPanel>
  <ListBox Grid.Row="2" ItemsSource="{Binding Sources}" IsEnabled="{Binding CanEdit}" HorizontalContentAlignment="Stretch">
   <ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="4,5"><StackPanel><TextBlock Text="{Binding Room.Title}"/><TextBlock Text="{Binding Availability}" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Grid Grid.Row="3" Margin="0,10,0,0" IsEnabled="{Binding CanEdit}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,8,0"><TextBlock Text="전달받을 방"/><ComboBox ItemsSource="{Binding Destinations}" SelectedItem="{Binding Destination}" DisplayMemberPath="Title" AutomationProperties.Name="요약 수신방"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="주기(분)"/><TextBox x:Name="IntervalInput" Text="{Binding IntervalMinutes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="요약 전달 주기"/></StackPanel>
  </Grid>
  <DockPanel Grid.Row="4" Margin="0,8,0,0" IsEnabled="{Binding CanEdit}">
   <Button Content="적용" DockPanel.Dock="Right" Click="Apply_Click" Padding="14,6"/>
   <CheckBox Content="추가사항이 있을 때 전달" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
  </DockPanel>
  <TextBlock Grid.Row="5" Text="{Binding Status}" ToolTip="{Binding Status}" TextWrapping="Wrap" MaxHeight="70" Margin="0,8,0,0" FontSize="11"/>
 </Grid>
</UserControl>
