<UserControl x:Class="KakaoRelay.App.CommandRoomPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <DockPanel><Button DockPanel.Dock="Right" Content="새로고침" Click="Refresh_Click" Padding="8,6"/><CheckBox Content="제어방 사용" IsChecked="{Binding Draft.Enabled}" VerticalAlignment="Center"/></DockPanel>
 <ComboBox Grid.Row="1" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" DisplayMemberPath="Title" Margin="0,8" AutomationProperties.Name="단일 1:1 제어방"/>
 <StackPanel Grid.Row="2"><TextBlock Text="{Binding Operator}" FontSize="11"/><CheckBox Content="자연어 명령 · 변경 전 확인" IsChecked="{Binding Draft.NaturalLanguage}" Margin="0,8"/><WrapPanel><CheckBox Content="자동답장" IsChecked="{Binding Draft.Reply}" Margin="0,0,12,0"/><CheckBox Content="지식 축적" IsChecked="{Binding Draft.Knowledge}" Margin="0,0,12,0"/><CheckBox Content="정리전달" IsChecked="{Binding Draft.Forward}" Margin="0,0,12,0"/><CheckBox Content="프로바이더" IsChecked="{Binding Draft.Provider}"/></WrapPanel></StackPanel>
 <DockPanel Grid.Row="3" Margin="0,10"><Button Content="적용" Click="Apply_Click" Padding="14,6" DockPanel.Dock="Right"/><TextBlock Text="일반 대화 + 관리 명령 · 1:1 방 하나" VerticalAlignment="Center" FontSize="11"/></DockPanel>
 <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8"/>
 <TabControl Grid.Row="5"><TabItem Header="이력"><TextBox Text="{Binding History, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem><TabItem Header="명령어"><TextBox Text="{Binding Help, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem></TabControl>
 </Grid>
</UserControl>
