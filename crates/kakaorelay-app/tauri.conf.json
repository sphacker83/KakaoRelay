{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KakaoRelay",
  "version": "0.10.0",
  "identifier": "com.kakaorelay.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KakaoRelay",
        "width": 490,
        "height": 760,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}